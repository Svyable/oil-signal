# Optional: required only for live EIA ingestion adapters.
EIA_API_KEY=

# Optional: OpenAI-compatible local/hosted model endpoint.
OILSIGNAL_LLM_BASE_URL=http://localhost:11434/v1
OILSIGNAL_LLM_API_KEY=
OILSIGNAL_LLM_MODEL=

# Optional: vendor-neutral alert webhook delivery.
# Secrets stay in the environment rather than CLI arguments.
OILSIGNAL_ALERT_WEBHOOK_URL=
OILSIGNAL_ALERT_WEBHOOK_BEARER_TOKEN=
OILSIGNAL_ALERT_WEBHOOK_SIGNING_SECRET=
OILSIGNAL_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# Keep false in production. Set true only for intentionally insecure local/private HTTP.
OILSIGNAL_ALERT_WEBHOOK_ALLOW_INSECURE_HTTP=false

# Optional: fallback per-call price for agent products without a SKU override.
# A price alone does not enforce payment; the gateway settings below must also be complete.
OILSIGNAL_AGENT_EVIDENCE_PACK_PRICE_USD=
# Optional JSON map of exact SKU -> amount overrides. A null value keeps that SKU unpriced.
# Example: {"fact-us-crude-stocks":"0.005","crude-balance-evidence":"0.10","refinery-utilization-evidence":null}
OILSIGNAL_AGENT_SKU_PRICES={}
OILSIGNAL_AGENT_PRICE_CURRENCY=USD

# Optional: connect OilSignal to a real remote payment verifier/settlement service.
# The service implements POST <URL>/challenge and POST <URL>/verify.
OILSIGNAL_AGENT_PAYMENT_GATEWAY_URL=
OILSIGNAL_AGENT_PAYMENT_GATEWAY_PROTOCOL=
# Comma-separated buyer credential headers forwarded to the verifier. No other request headers leave OilSignal.
OILSIGNAL_AGENT_PAYMENT_GATEWAY_CREDENTIAL_HEADERS=Authorization
# Optional operator-to-gateway bearer credential. Never returned to Evidence Pack buyers.
OILSIGNAL_AGENT_PAYMENT_GATEWAY_BEARER_TOKEN=
OILSIGNAL_AGENT_PAYMENT_GATEWAY_TIMEOUT_SECONDS=5
# Keep false in production. Set true only for intentionally insecure local/private HTTP.
OILSIGNAL_AGENT_PAYMENT_GATEWAY_ALLOW_INSECURE_HTTP=false
